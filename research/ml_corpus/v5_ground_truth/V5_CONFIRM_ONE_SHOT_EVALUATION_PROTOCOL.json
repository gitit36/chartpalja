    "BROAD_SENSITIVITY": {
      "source_quality": [
        "high",
        "medium"
      ]
    }
  },
  "pairing": {
    "collapse_same_subject_axis_year_polarity_before_pairing": true,
    "same_subject": true,
    "same_axis": true,
    "opposite_polarity": true,
    "same_year_forbidden": true,
    "min_abs_year_gap": 1,
    "max_abs_year_gap": 5,
    "use_all_eligible_local_pairs": true,
    "no_directional_pair_selection": true,
    "subject_weight": "1 / number_of_pairs_for_subject"
